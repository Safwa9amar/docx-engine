{
  "name": "docx-engine",
  "version": "2.0.0",
  "description": "Edit existing Word (.docx) files without mangling them — byte-faithful round-trip, real TOC/caption/footnote/citation structures, first-class Arabic RTL, and a validating docx doctor on every write. TypeScript, no Word or LibreOffice needed.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "openxml",
    "office",
    "document",
    "edit",
    "round-trip",
    "rtl",
    "arabic",
    "bidi",
    "toc",
    "table-of-contents",
    "captions",
    "footnotes",
    "citations",
    "headers",
    "footers",
    "sections",
    "tables",
    "typescript"
  ],
  "author": "Hamza Safwan",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzasafwan/mdocxengine"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && vite build --ssr",
    "test": "vitest --ui --coverage",
    "test:ci": "vitest run --coverage",
    "prepublishOnly": "npm run build --omit=dev",
    "lint": "eslint --flag unstable_ts_config --config eslint.config.ts",
    "predemo": "npm run build",
    "demo": "tsx ./demo/index.ts",
    "typedoc": "typedoc src/index.ts --tsconfig tsconfig.typedoc.json",
    "prettier": "prettier -l \"{src,scripts,demo}/**/*.{ts,html}\"",
    "prettier:fix": "npm run prettier -- --write",
    "cspell": "cspell \"{src,demo,docs,scripts}/**/*.{ts,scss,html,md}\" && cspell \"./*.*\"",
    "serve.docs": "cd docs && docsify serve",
    "extract": "tsx scripts/extract-document.ts",
    "run-ts": "tsx"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "adm-zip": "^0.5.16",
    "xml2js": "^0.6.2",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@google/genai": "^1.19.0",
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/xml2js": "^0.4.14",
    "@types/xmldom": "^0.1.34",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "dotenv": "^17.2.2",
    "eslint": "^9.35.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "module-alias": "^2.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prettier-plugin-xml": "^0.1.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "homepage": "https://github.com/hamzasafwan/mdocxengine#readme",
  "bugs": {
    "url": "https://github.com/hamzasafwan/mdocxengine/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
